# Copy to .env.local for development. In production, set these in the Vercel
# project settings instead (Settings > Environment Variables).

# The real public address, e.g. https://your-domain.com (no trailing slash).
# Leave EMPTY until the domain is live: while empty, the site tells search
# engines not to index it, so preview URLs never end up in Google.
NEXT_PUBLIC_SITE_URL=

# Where the "Brocare Insurance Brokerage" footer link points.
NEXT_PUBLIC_BROKERAGE_URL=https://brocareinsurance.com

# Instant demo booking link (Cal.com or Calendly), e.g. https://cal.com/brocare-ai/demo
# While empty, "Book a demo" falls back to WhatsApp and the request form.
NEXT_PUBLIC_BOOKING_URL=

# Lead capture email (Resend, https://resend.com).
# 1. Create an API key. 2. Verify the domain you send from. 3. Fill these in.
RESEND_API_KEY=
LEAD_TO_EMAIL=ali.m@brocareinsurance.com
LEAD_FROM_EMAIL=Brocare AI <leads@your-verified-domain.com>

# Development only. Logs a redacted summary instead of sending email.
# Ignored when NODE_ENV=production.
# LEAD_DRY_RUN=1
